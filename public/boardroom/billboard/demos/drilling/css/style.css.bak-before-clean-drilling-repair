:root{
  --orange:#f36d00;
  --orange-deep:#bb4500;
  --ink:#0b0b0b;
  --panel:#141414;
  --line:#414141;
}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#080b0a}
body{font-family:Arial,Helvetica,sans-serif;color:#fff}
button,input,textarea{font:inherit}
button{cursor:pointer}
.viewport{width:100vw;height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,#292929,#050706 72%)}
.site{position:relative;width:min(100vw,calc(100vh * 1.5));height:min(100vh,calc(100vw / 1.5));overflow:hidden;isolation:isolate;box-shadow:0 28px 100px #000}
.artwork{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;user-select:none;pointer-events:none}

.menu-toggle{position:absolute;z-index:20;top:5.1%;right:4.1%;display:flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.28);padding:10px 14px 10px 12px;color:#fff;background:rgba(10,10,10,.7);box-shadow:0 8px 22px rgba(0,0,0,.35);backdrop-filter:blur(8px);font-weight:900;letter-spacing:.12em}
.menu-toggle::after{content:"";position:absolute;left:12px;right:12px;bottom:-5px;height:2px;background:var(--orange);transform:scaleX(.35);transform-origin:right;transition:transform .2s ease}
.menu-toggle:hover::after,.menu-toggle:focus-visible::after{transform:scaleX(1)}
.menu-toggle:focus-visible,.menu-close:focus-visible,.drawer-link:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
.menu-icon{width:25px;display:grid;gap:5px}
.menu-icon i{display:block;height:2px;background:#fff;transition:transform .25s ease,opacity .2s ease}
body.menu-open .menu-icon i:nth-child(1){transform:translateY(7px) rotate(45deg)}
body.menu-open .menu-icon i:nth-child(2){opacity:0}
body.menu-open .menu-icon i:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

.menu-backdrop{position:absolute;z-index:30;inset:0;background:rgba(0,0,0,.48);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:opacity .28s ease,visibility .28s ease}
body.menu-open .menu-backdrop{opacity:1;visibility:visible}

.menu-drawer{position:absolute;z-index:40;top:0;right:0;width:min(66%,860px);height:100%;padding:3.5% 3.8% 3.2%;background:linear-gradient(145deg,rgba(26,26,26,.99),rgba(5,5,5,.995));border-left:1px solid #555;box-shadow:-28px 0 70px rgba(0,0,0,.72),inset 1px 0 rgba(255,255,255,.06);transform:translateX(104%);transition:transform .38s cubic-bezier(.22,.8,.2,1);overflow:hidden}
body.menu-open .menu-drawer{transform:translateX(0)}
.drawer-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid #383838}
.drawer-head p{margin:0;color:var(--orange);font-size:12px;font-weight:900;letter-spacing:.22em}
.menu-close{width:38px;height:38px;border:1px solid #494949;color:#fff;background:#111;font-size:28px;line-height:1}
.drawer-grid{display:grid;grid-template-columns:38% 1fr;gap:5%;height:calc(100% - 55px);padding-top:4%}
.drawer-nav{display:flex;flex-direction:column;gap:8px;padding-right:4%;border-right:1px solid #303030}
.drawer-link{display:flex;align-items:center;gap:12px;width:100%;border:0;border-bottom:1px solid #2f2f2f;padding:13px 8px;color:#d8d8d8;background:transparent;text-align:left;font-family:Impact,"Arial Narrow",sans-serif;font-size:clamp(16px,1.55vw,24px);letter-spacing:.035em;transition:.16s ease}
.drawer-link span{color:#777;font:700 10px/1 Arial,sans-serif;letter-spacing:.12em}
.drawer-link:hover,.drawer-link.is-active{padding-left:14px;color:#fff;background:linear-gradient(90deg,rgba(243,109,0,.16),transparent)}
.drawer-link.is-active span{color:var(--orange)}
.drawer-link--quote{margin-top:auto;border:1px solid #a84400;padding:14px 12px;background:linear-gradient(#f57a14,#ba4300);color:#fff}
.drawer-link--quote span{color:#ffe2cb}
.drawer-link--quote:hover,.drawer-link--quote.is-active{padding-left:16px;background:linear-gradient(#ff851d,#c74a00)}

.drawer-content{position:relative;overflow:auto;padding:2% 3% 2% 0}
.drawer-panel{display:none;animation:panelIn .24s ease both}
.drawer-panel.is-active{display:block}
@keyframes panelIn{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}
.panel-kicker{margin:0 0 10px;color:var(--orange);font-size:11px;font-weight:900;letter-spacing:.2em}
.drawer-panel h2{margin:0 0 18px;max-width:10ch;font-family:Impact,"Arial Narrow",sans-serif;font-size:clamp(28px,3vw,48px);font-weight:500;line-height:.95;letter-spacing:.02em;text-transform:uppercase}
.panel-list{display:grid;gap:0;border-top:1px solid #333}
.panel-list article{padding:14px 0;border-bottom:1px solid #333}
.panel-list strong{display:block;font-family:Impact,"Arial Narrow",sans-serif;font-size:clamp(18px,1.7vw,26px);letter-spacing:.03em}
.panel-list p{margin:5px 0 0;color:#bebebe;font-size:12px;line-height:1.4}
.quote-copy{max-width:42ch;margin:0 0 18px;color:#c5c5c5;font-size:13px;line-height:1.5}
form{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label{display:grid;gap:5px;color:#d8d8d8;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
label.full,form button,.form-status{grid-column:1/-1}
input,textarea{width:100%;border:1px solid #424242;border-radius:0;padding:10px;color:#fff;background:#0c0c0c;outline:none}
input:focus,textarea:focus{border-color:var(--orange);box-shadow:0 0 0 2px rgba(243,109,0,.15)}
form button{border:1px solid #ff9a46;padding:11px 14px;color:#fff;background:linear-gradient(#f57b16,#bf4700);font-weight:900;letter-spacing:.08em}
.form-status{min-height:1em;margin:0;color:#ff9b4a;font-size:11px}

@media(max-width:900px){
  .menu-drawer{width:82%}
  .drawer-grid{grid-template-columns:42% 1fr;gap:4%}
  .menu-toggle{top:4%;right:3%}
}
@media(max-width:620px){
  .menu-drawer{width:94%;padding:5%}
  .drawer-grid{grid-template-columns:1fr;height:auto;overflow:auto}
  .drawer-nav{border-right:0;border-bottom:1px solid #303030;padding:0 0 14px}
  .drawer-link--quote{margin-top:8px}
  .drawer-content{padding-top:18px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* === DRILLING ARTWORK TEXT REPAIRS === */

/* Repair misspelt "A HIOLE IN ONE" baked into artwork */
.site::before{
  content:"A HOLE IN ONE";
  position:absolute;
  z-index:5;
  left:9.7%;
  top:3.7%;
  width:20.5%;
  height:5.7%;
  display:flex;
  align-items:center;

  /* mask original wording */
  background:
    linear-gradient(
      90deg,
      rgba(14,14,13,.99) 0%,
      rgba(16,15,13,.97) 78%,
      rgba(18,16,14,0) 100%
    );

  color:#fff;
  font-family:Impact,"Arial Narrow",Arial,sans-serif;
  font-size:clamp(20px,2.55vw,40px);
  font-weight:500;
  line-height:1;
  letter-spacing:.035em;
  white-space:nowrap;
  pointer-events:none;
}

/* Repair overlapping Safety First body copy */
.site::after{
  content:"Zero compromise.\A Every job. Every day.\A Everyone goes home safe.";
  white-space:pre;
  position:absolute;
  z-index:5;
  left:75.45%;
  top:82.05%;
  width:10.2%;
  height:8.2%;
  padding-top:.35%;
  background:#111;
  color:#fff;
  font-family:Arial,Helvetica,sans-serif;
  font-size:clamp(8px,.92vw,14px);
  line-height:1.85;
  pointer-events:none;
}

