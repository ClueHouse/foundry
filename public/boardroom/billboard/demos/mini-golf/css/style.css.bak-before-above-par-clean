/* Billboard integration */
.back-to-billboard {
  position: fixed;
  z-index: 10000;
  top: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid rgba(255,255,255,.34);
  border-radius: 999px;
  background: rgba(8,8,8,.78);
  color: #fff;
  box-shadow: 0 8px 24px rgba(0,0,0,.28);
  backdrop-filter: blur(10px);
  font: 600 12px/1 "Segoe UI", Arial, sans-serif;
  letter-spacing: .06em;
  text-decoration: none;
  text-transform: uppercase;
}
.back-to-billboard:hover,
.back-to-billboard:focus-visible {
  background: rgba(0,0,0,.94);
  border-color: rgba(255,255,255,.7);
}

/* Tighten The Course overlay so it fits without scrolling */
.overlay--course .overlay-panel {
  padding: 46px 58px 38px;
  overflow: hidden;
}

.overlay--course .eyebrow {
  margin-bottom: 6px;
}

.overlay--course h1 {
  margin-bottom: 22px;
  font-size: 64px;
}

.overlay--course .course-grid {
  gap: 14px 16px;
}

.overlay--course .course-grid article {
  padding: 18px 22px;
}

.overlay--course .course-grid b {
  width: 42px;
  height: 42px;
  font-size: 18px;
}

.overlay--course .course-grid h2 {
  margin: 6px 0 8px;
  font-size: 24px;
}

.overlay--course .course-grid p {
  margin: 0;
  font-size: 17px;
  line-height: 1.42;
}

.overlay--course .panel-note {
  margin-top: 18px;
  padding: 13px 18px;
  font-size: 17px;
}

/* Clean overlay close buttons: X only, no visible circle */
.overlay-close,
.modal-close,
.close-button {
  width: 48px !important;
  height: 48px !important;
  padding: 0 !important;

  display: grid !important;
  place-items: center !important;

  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;

  color: #fff !important;
  font-size: 32px !important;
  font-weight: 300 !important;
  line-height: 1 !important;

  cursor: pointer;
  transition: transform .18s ease, opacity .18s ease;
}

.overlay-close:hover,
.modal-close:hover,
.close-button:hover {
  transform: scale(1.12);
  opacity: .8;
}

.overlay-close:focus-visible,
.modal-close:focus-visible,
.close-button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

/* Parties & Events — standalone email CTA */
.overlay--events .primary-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  margin-top: 20px;
  text-decoration: none;
  position: relative;
  z-index: 1;
}

/* =========================================================
   HERO FIT REPAIR
   Keep the complete hero artwork visible and clean up the
   replacement branding in the top-left corner.
   ========================================================= */

/* Show the complete 1536x1024 hero rather than cropping it */
.hero-art,
.hero-image,
.stage > img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
  object-position: center center !important;
}

/* Clean rectangular brand area — remove diagonal clipping */
.brand-mask {
  clip-path: none !important;
  overflow: hidden !important;
}

/* Keep replacement branding safely inside its own panel */
.brand-mask img {
  max-width: 100% !important;
  max-height: 100% !important;
  object-fit: contain !important;
  object-position: center !important;
}

