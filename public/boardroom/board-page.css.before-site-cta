:root{--ink:#251b13;--muted:#5e5146;--line:rgba(45,31,20,.34);--paper:rgba(249,242,229,.58);--paper-strong:rgba(255,249,238,.78);--shadow:rgba(35,22,12,.22);--serif:Georgia,"Times New Roman",serif;--sans:"Segoe UI",Arial,sans-serif;--board-bg:none}
*{box-sizing:border-box}html,body{margin:0;min-height:100%}body{min-height:100vh;color:var(--ink);font-family:var(--sans);background-image:linear-gradient(rgba(255,248,235,.08),rgba(255,248,235,.08)),var(--board-bg);background-size:cover;background-position:center}body.billboard{--board-bg:url("../assets/backgrounds/board-billboard.webp")}body.noticeboard{--board-bg:url("../assets/backgrounds/board-noticeboard.webp")}body.skateboard{--board-bg:url("../assets/backgrounds/board-skateboard.webp");--ink:#f4eadb;--muted:#d0c1ae;--line:rgba(255,240,216,.28);--paper:rgba(22,15,11,.64);--paper-strong:rgba(28,19,14,.76);--shadow:rgba(0,0,0,.4)}body.springboard{--board-bg:url("../assets/backgrounds/board-springboard.webp");--ink:#fff3e4;--muted:#e0c8b4;--line:rgba(255,239,220,.28);--paper:rgba(38,17,12,.62);--paper-strong:rgba(45,20,14,.72);--shadow:rgba(0,0,0,.38)}
a{color:inherit}.board-shell{width:min(1660px,calc(100% - 96px));height:100vh;margin:auto;display:grid;grid-template-rows:108px 1fr;overflow:hidden}
.board-nav{display:flex;align-items:center;justify-content:space-between;gap:42px;border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.12em;font-size:15px;font-weight:800}.board-nav a{text-decoration:none}.board-nav>a:first-child{white-space:nowrap;padding:16px 0;font-size:15px}.board-tabs{display:flex;align-items:center;gap:0}.board-tabs a{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 30px;color:var(--muted);border:1px solid transparent;border-radius:7px}.board-tabs a+a:before{content:"•";position:relative;left:-30px;color:var(--muted);opacity:.7}.board-tabs a:hover,.board-tabs a:focus-visible{color:var(--ink)}.board-tabs a.active{color:var(--ink);border-color:var(--line);background:rgba(255,255,255,.08)}.board-tabs a.active:before{visibility:hidden}
.board-main{min-height:0;display:grid;grid-template-columns:minmax(560px,1.15fr) minmax(430px,.85fr);grid-template-areas:"gallery intro";gap:clamp(44px,5vw,84px);align-items:center;padding:clamp(26px,3.5vh,44px) 0 clamp(30px,4vh,50px)}
.board-intro{grid-area:intro;align-self:center;background:var(--paper);border:1px solid var(--line);border-radius:34px;padding:clamp(34px,3.2vw,54px);box-shadow:0 24px 60px var(--shadow);backdrop-filter:blur(3px)}.board-kicker{margin:0 0 16px;text-transform:uppercase;letter-spacing:.18em;font-size:13px;font-weight:800}.board-title{margin:0;font:500 clamp(52px,4.7vw,84px)/.9 var(--serif);letter-spacing:-.045em}.board-tagline{margin:24px 0 18px;max-width:570px;font:500 clamp(27px,2.2vw,38px)/1.08 var(--serif)}.board-rule{display:block;width:58px;height:2px;background:currentColor;margin:24px 0;opacity:.65}.board-copy{max-width:590px;margin:0;color:var(--muted);font-size:clamp(15px,1vw,18px);line-height:1.55}.board-copy strong{color:var(--ink)}
.board-gallery{grid-area:gallery;min-width:0;align-self:center}.gallery-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin:0 0 14px}.gallery-head p{margin:0;text-transform:uppercase;letter-spacing:.15em;font-size:12px;font-weight:800}.gallery-head h2{margin:0;color:var(--muted);font:500 clamp(18px,1.5vw,26px)/1.08 var(--serif);text-align:right}.demo-grid{display:grid;grid-template-columns:1fr;gap:14px}.demo-card{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(180px,.7fr);min-width:0;min-height:148px;text-decoration:none;border:1px solid var(--line);background:var(--paper-strong);box-shadow:0 16px 38px var(--shadow);transition:transform .2s ease,box-shadow .2s ease;overflow:hidden;border-radius:6px}.demo-card:hover,.demo-card:focus-visible{transform:translateX(5px);box-shadow:0 22px 48px var(--shadow)}.demo-card img{display:block;width:100%;height:100%;min-height:148px;max-height:180px;object-fit:cover}.demo-meta{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:14px;padding:18px 20px}.demo-meta strong{font:500 clamp(22px,1.7vw,30px)/1.02 var(--serif)}.demo-meta span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;white-space:nowrap}:focus-visible{outline:2px solid currentColor;outline-offset:4px}
@media(max-height:760px) and (min-width:981px){.board-shell{grid-template-rows:88px 1fr}.board-main{padding:18px 0 24px}.board-intro{padding:28px 34px;border-radius:28px}.board-title{font-size:clamp(46px,4.1vw,70px)}.board-tagline{margin:16px 0 10px;font-size:clamp(23px,1.9vw,31px)}.board-rule{margin:16px 0}.board-copy{font-size:14px}.gallery-head{margin-bottom:10px}.demo-grid{gap:10px}.demo-card{min-height:126px}.demo-card img{min-height:126px;max-height:145px}.demo-meta{padding:12px 16px;gap:10px}}
@media(max-width:1250px) and (min-width:981px){.board-shell{width:calc(100% - 56px)}.board-nav{font-size:13px}.board-nav>a:first-child{font-size:13px}.board-tabs a{padding:0 18px}.board-tabs a+a:before{left:-18px}.board-main{grid-template-columns:minmax(480px,1.05fr) minmax(360px,.8fr);gap:34px}.gallery-head h2{display:none}.board-intro{padding:32px}.demo-card{grid-template-columns:minmax(0,1.45fr) minmax(150px,.6fr)}}
@media(max-width:980px){body{overflow:auto}.board-shell{width:min(100% - 40px,780px);height:auto;min-height:100vh;display:block;overflow:visible}.board-nav{align-items:flex-start;padding:20px 0;flex-direction:column;font-size:13px}.board-nav>a:first-child{font-size:13px}.board-tabs{width:100%;overflow:auto}.board-tabs a{padding:0 14px;min-height:42px;font-size:11px}.board-tabs a+a:before{left:-14px}.board-main{display:flex;flex-direction:column;padding:44px 0 70px}.board-intro{order:1;width:100%;margin-bottom:38px;padding:32px;border-radius:28px}.board-gallery{order:2;width:100%}.gallery-head{align-items:flex-start;flex-direction:column}.gallery-head h2{text-align:left}.demo-card{grid-template-columns:1fr}.demo-card img{height:auto;min-height:0;max-height:none;aspect-ratio:16/9}.demo-meta{flex-direction:row;align-items:center;justify-content:space-between}}
@media(max-width:560px){.board-shell{width:calc(100% - 28px)}.board-tabs{gap:4px}.board-tabs a{padding:0 10px}.board-tabs a+a:before{display:none}.board-title{font-size:48px}.board-tagline{font-size:28px}.board-intro{padding:26px 24px;border-radius:24px}.demo-meta{align-items:flex-start;flex-direction:column}}



/* Board intro: transparent tinted glass */
body.billboard  { --panel-hue: 92, 58, 25; }
body.noticeboard { --panel-hue: 104, 64, 31; }
body.skateboard { --panel-hue: 30, 38, 43; }
body.springboard { --panel-hue: 91, 38, 28; }

.board-intro {
  color: #fff8ee;
  background: rgba(var(--panel-hue), .48);
  border: 1px solid rgba(224, 164, 88, .62);
  box-shadow:
    inset 0 0 0 1px rgba(255, 225, 184, .10),
    0 18px 42px rgba(0, 0, 0, .20);
  -webkit-backdrop-filter: blur(8px) saturate(90%);
  backdrop-filter: blur(8px) saturate(90%);
}

.board-intro .board-kicker { color: #efa64d; }
.board-intro .board-title,
.board-intro .board-tagline { color: #fff8ee; }
.board-intro .board-copy { color: rgba(255, 248, 238, .86); }
.board-intro .board-copy strong { color: #fff; }
.board-intro .board-rule { background: #dfa052; opacity: 1; }

/* Noticeboard — examples heading */
.noticeboard-page .gallery-heading {
  color: #fff7ec !important;
}
