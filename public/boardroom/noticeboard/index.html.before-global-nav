<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#100b08">
  <meta name="description" content="Noticeboard — websites with owner-editable information from Foundry by RKDB.">
  <title>Noticeboard | Foundry by RKDB</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="../" aria-label="Foundry Boardroom">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span class="brand-copy"><strong>FOUNDRY</strong><small>BY RKDB</small></span>
    </a>
    <nav class="site-nav" aria-label="Product navigation">
      <a href="../">Boardroom</a>
      <a class="active" href="./" aria-current="page">Noticeboard</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="noticeboard-title">
      <div class="hero-copy">
        <p class="eyebrow">Noticeboard</p>
        <h1 id="noticeboard-title">Noticeboard</h1>
        <h2>A website that keeps up with you.</h2>
        <span class="accent-rule" aria-hidden="true"></span>
        <p>Update the information that changes most—specials, availability, progress or announcements—without rebuilding the website.</p>
        <p>A polished Foundry site with a clearly defined area that the owner can keep current.</p>
        <p class="closing-line">When the website stays the same, but the message needs to move.</p>
        <a class="hero-action" href="#demonstrations">Explore the demonstrations <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img src="assets/images/noticeboard-hero.jpg" alt="">
        <span class="hero-glow"></span>
      </div>
    </section>

    <section class="demonstrations" id="demonstrations" aria-labelledby="demonstrations-title">
      <div class="section-heading">
        <p class="eyebrow">Fresh information</p>
        <h2 id="demonstrations-title">Three businesses. Three useful noticeboards.</h2>
      </div>
      <div class="demo-grid">
        <a class="demo-card demo-card--diner" href="demos/diner/index.html">
          <img src="assets/images/diner-preview.webp" alt="On the Road diner website preview">
          <span class="demo-meta"><strong>Diner</strong><span>View Demo →</span></span>
        </a>
        <a class="demo-card demo-card--produce" href="demos/produce/index.html">
          <img src="assets/images/produce-preview.png" alt="On the Road produce stall website preview">
          <span class="demo-meta"><strong>Produce</strong><span>View Demo →</span></span>
        </a>
        <a class="demo-card demo-card--walk" href="demos/charity-walk/index.html">
          <img src="assets/images/charity-walk-preview.jpg" alt="On the Road charity walk website preview">
          <span class="demo-meta"><strong>Charity Walk</strong><span>View Demo →</span></span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>Foundry by RKDB</span>
    <a href="../">Boardroom</a>
  </footer>
</body>
</html>
