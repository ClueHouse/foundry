@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Caveat:wght@600&family=Nunito+Sans:wght@400;600;700&display=swap');

:root {
  --green: #17381e;
  --green-deep: #102a16;
  --green-soft: #789b38;
  --orange: #d36f2f;
  --cream: #fbf5e6;
  --wood-a: #8b5a34;
  --wood-b: #4f2e19;
}

* { box-sizing: border-box; }

html, body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
}

body {
  font-family: "Nunito Sans", sans-serif;
  color: var(--green);
  background: #d8d2bd;
}

button, a { font: inherit; }

.page {
  position: relative;
  width: 100%;
  height: 100dvh;
  min-height: 680px;
  overflow: hidden;
  isolation: isolate;
}

.scene {
  position: absolute;
  inset: 0;
  z-index: -3;
  background-image:
    linear-gradient(180deg, rgba(255,255,255,.08), transparent 26%),
    url("assets/country-scene.png");
  background-position: center center;
  background-size: cover;
  background-repeat: no-repeat;
}

.scene::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255,255,255,.02), transparent 56%, rgba(255,247,221,.16)),
    radial-gradient(circle at 75% 35%, rgba(255,244,199,.26), transparent 32%);
}

.header {
  position: absolute;
  inset: 0 0 auto 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32px 5.2vw 0;
}

.brand {
  display: flex;
  flex-direction: column;
  color: var(--green);
  text-decoration: none;
  line-height: 1;
  text-shadow:
    0 2px 0 rgba(255,255,255,.38),
    0 5px 18px rgba(255,255,255,.78);
}

.brand-main {
  font-family: "Barlow Condensed", sans-serif;
  font-size: clamp(4rem, 6.2vw, 7rem);
  font-weight: 800;
  letter-spacing: .025em;
}

.brand-sub {
  align-self: center;
  margin-top: 7px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: clamp(1.5rem, 2.25vw, 2.6rem);
  letter-spacing: .19em;
}

.brand-tagline {
  align-self: center;
  margin-top: 10px;
  color: var(--orange);
  font-family: "Caveat", cursive;
  font-size: clamp(1.65rem, 2vw, 2.25rem);
}

.brand-tagline::after {
  content: "";
  display: block;
  width: 82%;
  height: 5px;
  margin: 5px auto 0;
  border-radius: 999px;
  background: var(--green-soft);
  transform: rotate(-1deg);
  box-shadow: 0 2px 7px rgba(255,255,255,.5);
}

nav {
  display: flex;
  align-items: center;
  gap: 23px;
  margin-top: 12px;
}

nav span {
  width: 1px;
  height: 27px;
  background: rgba(23,56,30,.38);
}

nav button {
  border: 0;
  background: transparent;
  padding: 7px 1px;
  color: var(--green);
  cursor: pointer;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  text-shadow: 0 1px 8px rgba(255,255,255,.75);
}

.board-zone {
  position: absolute;
  z-index: 7;
  right: 7.8vw;
  top: 18vh;
  width: min(28vw, 500px);
  height: min(64vh, 640px);
  outline: none;
}

.board {
  width: 100%;
  height: 100%;
  padding: 11px;
  border: 4px solid var(--wood-b);
  border-radius: 17px;
  background:
    linear-gradient(90deg, rgba(255,255,255,.1), transparent 18% 84%, rgba(0,0,0,.15)),
    repeating-linear-gradient(8deg, var(--wood-a) 0 18px, #704321 19px 25px);
  box-shadow: 0 20px 44px rgba(42,28,14,.34);
  transition: transform .25s ease, filter .25s ease, box-shadow .25s ease;
}

.board-face {
  height: 100%;
  padding: 21px 27px 16px;
  color: #f6f1e7;
  border-radius: 10px;
  background:
    radial-gradient(circle at 24% 12%, rgba(255,255,255,.03), transparent 24%),
    linear-gradient(180deg, #242924, #171a17);
  box-shadow: inset 0 0 34px rgba(0,0,0,.72);
  display: grid;
  grid-template-rows: auto auto 1fr auto;
}

.board h1 {
  margin: 0;
  text-align: center;
  font-family: "Barlow Condensed", sans-serif;
  font-size: clamp(1.8rem, 3.35vh, 2.9rem);
  letter-spacing: .04em;
}

.rule {
  height: 3px;
  margin: 9px 0;
  background: #9bc23f;
}

.board ol {
  min-height: 0;
  margin: 0;
  padding-left: 2em;
  display: grid;
  grid-template-rows: repeat(10, 1fr);
  font-family: "Caveat", cursive;
  font-size: clamp(1.05rem, 2.05vh, 1.65rem);
}

.board li {
  padding: 1px 2px 2px 6px;
  border-bottom: 1px dashed rgba(246,241,231,.32);
}

.board li::marker {
  font-family: "Barlow Condensed", sans-serif;
  font-size: .8em;
}

.board strong {
  float: right;
  font-family: "Barlow Condensed", sans-serif;
  font-size: .9em;
}

.board p {
  margin: 9px 0 0;
  color: #9bc23f;
  text-align: center;
  font-family: "Caveat", cursive;
  font-size: clamp(1.25rem, 2.3vh, 1.85rem);
}

.edit-tip {
  position: absolute;
  top: 8%;
  right: 5%;
  padding: 10px 15px;
  border: 1px solid #c69a42;
  border-radius: 10px;
  background: rgba(255,249,223,.97);
  color: #171a16;
  box-shadow: 0 8px 22px rgba(65,45,14,.22);
  opacity: 0;
  transform: translateY(8px);
  pointer-events: none;
  transition: .22s ease;
}

.edit-tip span,
.edit-tip strong { display: block; }

.board-zone:hover .board,
.board-zone:focus-visible .board,
.board-zone.active .board {
  transform: translateY(-3px);
  filter: brightness(1.09);
  box-shadow:
    0 0 38px rgba(255,183,57,.46),
    0 22px 46px rgba(42,28,14,.36);
}

.board-zone:hover .edit-tip,
.board-zone:focus-visible .edit-tip,
.board-zone.active .edit-tip {
  opacity: 1;
  transform: translateY(0);
}

.footer {
  position: absolute;
  z-index: 6;
  left: 11vw;
  right: 11vw;
  bottom: 0;
  height: 86px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  border-radius: 18px 18px 0 0;
  background: rgba(255,249,229,.9);
  box-shadow: 0 -8px 24px rgba(43,31,17,.12);
  backdrop-filter: blur(10px);
}

.footer div {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 22px;
}

.footer div + div {
  border-left: 1px solid rgba(23,56,30,.28);
}

.footer b {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 1.16rem;
}

.footer span {
  margin-top: 3px;
  font-size: .88rem;
}

.scrim {
  position: absolute;
  inset: 0;
  z-index: 20;
  background: rgba(10,20,12,.24);
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s ease;
}

.scrim.active {
  opacity: 1;
  pointer-events: auto;
}

.side-panel {
  position: absolute;
  z-index: 25;
  top: 0;
  right: 0;
  width: min(420px, 88vw);
  height: 100%;
  padding: 76px 42px 40px;
  overflow: hidden;
  transform: translateX(105%);
  box-shadow: -18px 0 48px rgba(16,26,17,.24);
  transition: transform .42s cubic-bezier(.22,.8,.25,1);
}

.side-panel.open {
  transform: translateX(0);
}

.about-panel {
  color: #f7f1df;
  background:
    radial-gradient(circle at 78% 12%, rgba(255,255,255,.05), transparent 22%),
    linear-gradient(180deg, #18351e, #102716);
  border-left: 8px solid #69401f;
}

.find-panel {
  color: var(--green);
  background:
    linear-gradient(90deg, rgba(105,64,31,.07), transparent 16%),
    #fbf4e4;
  border-left: 8px solid #704523;
}

.panel-close {
  position: absolute;
  top: 22px;
  right: 25px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-size: 2.1rem;
  line-height: 1;
}

.eyebrow {
  margin: 0;
  font-family: "Barlow Condensed", sans-serif;
  font-weight: 800;
  letter-spacing: .14em;
  opacity: .72;
}

.side-panel h2 {
  margin: 10px 0 22px;
  font-family: "Barlow Condensed", sans-serif;
  font-size: 2.65rem;
  line-height: 1;
}

.side-panel > p {
  line-height: 1.65;
}

.script-line {
  color: var(--orange);
  font-family: "Caveat", cursive;
  font-size: 1.65rem;
}

.panel-card {
  margin-top: 18px;
  padding: 17px 18px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;
  background: rgba(255,255,255,.055);
}

.panel-card strong,
.panel-card span {
  display: block;
}

.panel-card strong {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 1.25rem;
  letter-spacing: .05em;
}

.panel-card span {
  margin-top: 4px;
  font-size: .91rem;
  opacity: .78;
}

.thank-you {
  position: absolute;
  left: 42px;
  right: 42px;
  bottom: 36px;
  font-family: "Caveat", cursive;
  font-size: 1.35rem;
  opacity: .85;
}

.directions {
  margin: 24px 0;
  display: grid;
  gap: 14px;
}

.directions > div {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 12px;
  align-items: start;
}

.directions > div > span {
  font-size: 1.55rem;
}

.directions p {
  margin: 0;
  display: flex;
  flex-direction: column;
}

.directions small {
  margin-top: 2px;
  opacity: .68;
}

.map-card {
  position: relative;
  height: 190px;
  overflow: hidden;
  border: 1px solid rgba(23,56,30,.14);
  border-radius: 14px;
  background:
    radial-gradient(circle at 20% 20%, rgba(110,146,71,.2), transparent 28%),
    #e7e5c9;
}

.map-road {
  position: absolute;
  left: -10%;
  width: 120%;
  height: 26px;
  border: 3px solid #f8f0dc;
  background: #cdb98e;
}

.road-one { top: 65px; transform: rotate(-12deg); }
.road-two { top: 112px; transform: rotate(16deg); }

.map-pin {
  position: absolute;
  left: 58%;
  top: 70px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50% 50% 50% 0;
  color: white;
  background: var(--orange);
  transform: rotate(-45deg);
}

.map-card b {
  position: absolute;
  right: 17px;
  bottom: 16px;
  text-align: right;
  font-family: "Barlow Condensed", sans-serif;
}

.contact-card {
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid rgba(23,56,30,.2);
  display: grid;
  gap: 6px;
}

.contact-card strong {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 1.15rem;
}

@media (max-width: 1050px) {
  .board-zone {
    right: 4.5vw;
    width: min(35vw, 470px);
  }

  .footer {
    left: 4vw;
    right: 4vw;
  }
}

@media (max-width: 760px) {
  .header {
    padding: 17px 18px 0;
  }

  .brand-main { font-size: 2.15rem; }
  .brand-sub { font-size: 1rem; }
  .brand-tagline { font-size: 1.1rem; }

  nav { gap: 10px; }
  nav span { display: none; }
  nav button { font-size: .92rem; }

  .board-zone {
    top: 25vh;
    right: 4vw;
    width: 56vw;
    height: 57vh;
  }

  .footer {
    left: 0;
    right: 0;
    height: 78px;
    border-radius: 0;
  }

  .footer span { display: none; }
  .footer b { font-size: .88rem; text-align: center; }

  .side-panel {
    width: min(390px, 94vw);
    padding: 68px 28px 32px;
  }

  .thank-you {
    left: 28px;
    right: 28px;
  }
}
