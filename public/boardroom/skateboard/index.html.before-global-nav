<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#100b08">
  <meta name="description" content="Skateboard — immersive parallax websites from Foundry by RKDB.">
  <title>Skateboard | Foundry by RKDB</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="../" aria-label="Foundry Boardroom">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span class="brand-copy"><strong>FOUNDRY</strong><small>BY RKDB</small></span>
    </a>
    <nav class="site-nav" aria-label="Product navigation">
      <a href="../">Boardroom</a>
      <a class="active" href="./" aria-current="page">Skateboard</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="skateboard-title">
      <div class="hero-copy">
        <p class="eyebrow">Skateboard</p>
        <h1 id="skateboard-title">Skateboard</h1>
        <h2>A website with movement built in.</h2>
        <span class="accent-rule" aria-hidden="true"></span>
        <p>Layered imagery, smooth transitions and parallax motion turn scrolling into part of the story.</p>
        <p>Ideal for visual businesses that want visitors to feel the atmosphere, not simply read about it.</p>
        <p class="closing-line">When the journey through the site matters as much as the destination.</p>
        <a class="hero-action" href="#demonstrations">Explore the demonstrations <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img src="assets/images/skateboard-hero.webp" alt="">
        <span class="hero-glow"></span>
      </div>
    </section>

    <section class="demonstrations" id="demonstrations" aria-labelledby="demonstrations-title">
      <div class="section-heading">
        <p class="eyebrow">In motion</p>
        <h2 id="demonstrations-title">Three industries. Three immersive journeys.</h2>
      </div>
      <div class="demo-grid">
        <a class="demo-card demo-card--florist" href="demos/florist/index.html">
          <img src="assets/images/florist-preview.jpg" alt="Florist parallax website preview">
          <span class="demo-meta"><strong>Florist</strong><span>View Demo →</span></span>
        </a>
        <a class="demo-card demo-card--pottery" href="demos/pottery/index.html">
          <img src="assets/images/pottery-preview.webp" alt="Pottery studio parallax website preview">
          <span class="demo-meta"><strong>Pottery</strong><span>View Demo →</span></span>
        </a>
        <a class="demo-card demo-card--tailor" href="demos/tailor/index.html">
          <img src="assets/images/tailor-preview.webp" alt="Tailor parallax website preview">
          <span class="demo-meta"><strong>Tailor</strong><span>View Demo →</span></span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>Foundry by RKDB</span>
    <a href="../">Boardroom</a>
  </footer>
</body>
</html>
