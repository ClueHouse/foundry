    border-left: 0 !important;
  }

  .foundrycare-services article:last-child {
    padding-right: 0;
  }

  .foundrycare-services article::before {
    display: none !important;
  }


  /* ICONS */

  .foundrycare-service-icon {
    width: 29px;
    height: 29px;

    margin: 0 0 15px;

    color: var(--fc-bronze);
  }

  .foundrycare-service-icon svg {
    width: 100%;
    height: 100%;

    display: block;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* SERVICE HEADINGS */

  .foundrycare-services h2 {
    min-height: 2.35em;

    margin: 0 0 10px;

    color: var(--fc-ink) !important;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(.91rem, .91vw, 1rem);
    font-weight: 400;
    line-height: 1.12;
  }


  /* SERVICE COPY */

  .foundrycare-services p {
    margin: 0;

    color: var(--fc-body) !important;

    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(.65rem, .64vw, .72rem);
    font-weight: 400;
    line-height: 1.47;
  }


  /* OLD FOOTER ACTIONS */

  .foundrycare-actions {
    display: none !important;
  }
}


/* SHORTER DESKTOPS */

@media (min-width: 1051px) and (max-height: 780px) {

  .foundrycare-content {
    padding-top: 9vh;
  }

  .foundrycare-kicker {
    margin-bottom: 13px;
  }

  .foundrycare-content h1 {
    font-size: clamp(3.7rem, 4.15vw, 4.7rem);
  }

  .foundrycare-intro {
    margin-top: 20px;
  }

  .foundrycare-promise {
    margin-bottom: 18px;
  }

  .foundrycare-services article,
  .foundrycare-services article:nth-child(even) {
    padding-top: 20px;
  }

  .foundrycare-service-icon {
    width: 25px;
    height: 25px;
    margin-bottom: 11px;
  }
}


/* =========================================================
   FOUNDRYCARE — LARGE CENTRED SERVICE ICONS
   ========================================================= */

@media (min-width: 1051px) {

  .foundrycare-service-icon {
    width: 44px !important;
    height: 44px !important;

    margin:
      0
      auto
      18px !important;

    color: #a86129;
  }

  .foundrycare-service-icon svg {
    width: 100%;
    height: 100%;

    display: block;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
}
