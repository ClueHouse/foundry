:root {
  color-scheme: dark;

  --cream: #f3eee7;
  --warm: #d9c5ad;
  --muted: rgba(233, 217, 198, 0.72);

  --bronze: #d88a2d;
  --bronze-soft: #b56e25;

  --glass: rgba(10, 9, 8, 0.64);
  --glass-border: rgba(235, 203, 167, 0.30);
  --glass-border-soft: rgba(235, 203, 167, 0.13);

  --page-width: 1760px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

html {
  background: #080604;
}

body {
  min-height: 100vh;
  overflow-x: hidden;

  color: var(--cream);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:
    #080604
    url("../assets/backgrounds/boardroom.webp")
    center center / cover
    fixed
    no-repeat;
}


/* ---------------------------------------------------------
   ATMOSPHERE
--------------------------------------------------------- */

.page-shade {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(2, 2, 2, 0.58) 0%,
      rgba(2, 2, 2, 0.24) 35%,
      rgba(2, 2, 2, 0.08) 57%,
      rgba(2, 2, 2, 0.30) 100%
    ),
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.34) 0%,
      transparent 26%,
      transparent 70%,
      rgba(0, 0, 0, 0.38) 100%
    );
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  box-shadow:
    inset 0 0 180px rgba(0, 0, 0, 0.48),
    inset 0 -80px 130px rgba(0, 0, 0, 0.36);
}


/* ---------------------------------------------------------
   HEADER
--------------------------------------------------------- */

.site-header {
  position: relative;
  z-index: 10;

  width: min(var(--page-width), calc(100% - 96px));
  height: 112px;
  margin-inline: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(216, 138, 45, 0.28);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 15px;

  color: var(--cream);
  text-decoration: none;
}

.brand-mark {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(216, 138, 45, 0.68);
  border-radius: 12px;

  color: var(--bronze);
  font-size: 23px;

  background: rgba(13, 10, 7, 0.62);
  box-shadow:
    inset 0 0 28px rgba(216, 138, 45, 0.07),
    0 10px 30px rgba(0, 0, 0, 0.22);
}

.brand-copy {
  display: grid;
  line-height: 1;
}

.brand-copy strong {
  font-size: 1.08rem;
  letter-spacing: 0.17em;
}

.brand-copy small {
  margin-top: 8px;

  color: #d6b890;
  font-size: 0.70rem;
  letter-spacing: 0.31em;
}

.header-link {
  min-height: 48px;
  padding: 0 18px;

  display: inline-flex;
  align-items: center;
  gap: 22px;

  border: 1px solid rgba(216, 138, 45, 0.38);
  border-radius: 10px;

  color: #ead9c6;
  text-decoration: none;
  font-size: 0.95rem;

  background: rgba(7, 6, 5, 0.38);
  backdrop-filter: blur(10px);

  transition:
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.header-link span {
  color: var(--bronze);
  font-size: 1.3rem;
}

.header-link:hover,
.header-link:focus-visible {
  transform: translateY(-1px);

  border-color: rgba(216, 138, 45, 0.72);
  background: rgba(15, 11, 8, 0.72);
}


/* ---------------------------------------------------------
   PAGE LAYOUT
--------------------------------------------------------- */

.boardroom {
  position: relative;
  z-index: 2;

  width: min(var(--page-width), calc(100% - 96px));
  min-height: calc(100vh - 112px);
  margin-inline: auto;

  display: grid;
  grid-template-columns:
    minmax(420px, 0.92fr)
    minmax(650px, 1.08fr);

  gap: clamp(50px, 6vw, 120px);

  align-items: center;

  padding:
    clamp(48px, 6vh, 92px)
    0
    clamp(54px, 7vh, 100px);
}


/* ---------------------------------------------------------
   INTRO
--------------------------------------------------------- */

.intro {
  align-self: center;
  max-width: 680px;
  padding-bottom: 8vh;
}

.eyebrow {
  margin: 0 0 24px;

  color: var(--bronze);
  font-size: 0.77rem;
  font-weight: 800;
  letter-spacing: 0.25em;
  text-transform: uppercase;
}

h1 {
  margin: 0;

  max-width: 680px;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(4.3rem, 5.25vw, 7rem);
  font-weight: 400;
  line-height: 0.91;
  letter-spacing: -0.055em;

  text-shadow: 0 5px 28px rgba(0, 0, 0, 0.42);
}

h1 span {
  color: var(--bronze);
}

.intro-rule {
  width: 44px;
  height: 2px;

  margin: 38px 0 31px;

  background: var(--bronze);
  box-shadow: 0 0 18px rgba(216, 138, 45, 0.34);
}

.intro-copy {
  margin: 0;

  color: var(--warm);
  font-size: clamp(1rem, 1.25vw, 1.2rem);
  line-height: 1.8;

  text-shadow: 0 2px 15px #000;
}


/* ---------------------------------------------------------
   BOARD STACK
--------------------------------------------------------- */

.boards {
  display: grid;
  gap: 19px;

  width: 100%;
  max-width: 800px;

  justify-self: end;
}

.board-card {
  position: relative;

  min-height: 178px;
  padding: 25px 66px 25px 25px;

  display: grid;

  grid-template-columns:
    58px
    76px
    minmax(220px, 1.25fr)
    minmax(190px, 0.95fr);

  align-items: center;
  gap: 18px;

  border: 1px solid var(--glass-border);
  border-radius: 14px;

  color: var(--cream);
  text-decoration: none;

  background:
    linear-gradient(
      112deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.012) 42%,
      rgba(0, 0, 0, 0.13)
    ),
    var(--glass);

  backdrop-filter: blur(16px) saturate(0.85);
  -webkit-backdrop-filter: blur(16px) saturate(0.85);

  box-shadow:
    0 26px 50px rgba(0, 0, 0, 0.30),
    inset 0 1px 0 rgba(255, 255, 255, 0.07),
    inset 0 -1px 0 rgba(0, 0, 0, 0.42);

  isolation: isolate;

  transition:
    transform 220ms ease,
    border-color 220ms ease,
    background 220ms ease,
    box-shadow 220ms ease;
}


/* glass sheets sitting behind each board */

.glass-layer {
  position: absolute;
  inset: 8px 5px -8px 9px;
  z-index: -2;

  border: 1px solid var(--glass-border-soft);
  border-radius: 13px;

  background: rgba(11, 9, 7, 0.18);
  backdrop-filter: blur(4px);

  pointer-events: none;
}

.glass-layer--one {
  transform: translate(7px, 5px);
}

.glass-layer--two {
  z-index: -3;
  opacity: 0.58;
  transform: translate(13px, 10px);
}


/* fine inner reflection */

.board-card::before {
  content: "";
  position: absolute;
  inset: 1px;

  border-radius: 13px;

  pointer-events: none;

  background:
    linear-gradient(
      130deg,
      rgba(255, 255, 255, 0.045),
      transparent 25%,
      transparent 78%,
      rgba(216, 138, 45, 0.025)
    );
}


/* vertical divider */

.board-card::after {
  content: "";
  position: absolute;

  top: 27px;
  bottom: 27px;
  right: 31%;

  width: 1px;

  background:
    linear-gradient(
      transparent,
      rgba(229, 206, 181, 0.19) 12%,
      rgba(229, 206, 181, 0.19) 88%,
      transparent
    );
}

.board-card:hover,
.board-card:focus-visible {
  transform: translateX(-7px);

  border-color: rgba(216, 138, 45, 0.58);

  background:
    linear-gradient(
      112deg,
      rgba(255, 255, 255, 0.072),
      rgba(255, 255, 255, 0.017) 42%,
      rgba(12, 8, 5, 0.20)
    ),
    rgba(12, 10, 8, 0.72);

  box-shadow:
    10px 30px 65px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}


/* ---------------------------------------------------------
   CARD CONTENT
--------------------------------------------------------- */

.board-number {
  align-self: start;
  padding-top: 7px;

  color: rgba(239, 228, 214, 0.55);

  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.7rem;
}

.board-icon {
  width: 66px;
  height: 66px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(216, 138, 45, 0.58);
  border-radius: 13px;

  color: #e8c18c;

  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;

  background:
    radial-gradient(
      circle at 50% 15%,
      rgba(216, 138, 45, 0.11),
      transparent 64%
    ),
    rgba(7, 6, 5, 0.30);

  box-shadow:
    inset 0 0 24px rgba(216, 138, 45, 0.035),
    0 10px 25px rgba(0, 0, 0, 0.18);
}

.board-main {
  display: block;
  padding-right: 14px;
}

.board-label {
  display: block;

  margin-bottom: 12px;

  color: #d99441;

  font-size: 0.69rem;
  font-weight: 800;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.board-main strong {
  display: block;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.22rem, 1.35vw, 1.52rem);
  font-weight: 400;
  line-height: 1.24;
}

.board-description {
  padding-left: 20px;

  color: var(--muted);

  font-size: 0.91rem;
  line-height: 1.6;
}

.board-arrow {
  position: absolute;
  top: 24px;
  right: 24px;

  color: var(--bronze);
  font-size: 1.5rem;

  transition: transform 180ms ease;
}

.board-card:hover .board-arrow,
.board-card:focus-visible .board-arrow {
  transform: translateX(5px);
}


/* ---------------------------------------------------------
   TABLET
--------------------------------------------------------- */

@media (max-width: 1250px) {

  body {
    background-attachment: scroll;
  }

  .boardroom {
    grid-template-columns: 0.8fr 1.2fr;
    gap: 42px;
  }

  .board-card {
    grid-template-columns:
      45px
      62px
      minmax(180px, 1fr);

    padding-right: 54px;
  }

  .board-description {
    display: none;
  }

  .board-card::after {
    display: none;
  }

  .board-icon {
    width: 58px;
    height: 58px;
  }
}


/* ---------------------------------------------------------
   MOBILE
--------------------------------------------------------- */

@media (max-width: 820px) {

  body {
    background-position: 38% center;
  }

  .page-shade {
    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.42),
        rgba(0, 0, 0, 0.63)
      );
  }

  .site-header,
  .boardroom {
    width: min(100% - 30px, var(--page-width));
  }

  .site-header {
    height: 82px;
  }

  .brand-mark {
    width: 43px;
    height: 43px;
  }

  .brand-copy strong {
    font-size: 0.9rem;
  }

  .brand-copy small {
    display: none;
  }

  .header-link {
    min-height: 42px;
    padding: 0 13px;
    font-size: 0.80rem;
  }

  .boardroom {
    min-height: auto;

    grid-template-columns: 1fr;

    gap: 54px;

    padding: 60px 0 70px;
  }

  .intro {
    max-width: 520px;
    padding-bottom: 0;
  }

  h1 {
    font-size: clamp(3.5rem, 16vw, 5.4rem);
  }

  .intro-copy br {
    display: none;
  }

  .boards {
    max-width: none;
  }

  .board-card {
    min-height: 158px;

    grid-template-columns:
      40px
      56px
      minmax(0, 1fr);

    gap: 13px;

    padding:
      22px
      52px
      22px
      18px;
  }

  .board-number {
    font-size: 1.25rem;
  }

  .board-icon {
    width: 52px;
    height: 52px;

    font-size: 1.55rem;
  }

  .board-label {
    margin-bottom: 8px;
  }

  .board-main strong {
    font-size: 1.16rem;
  }

  .board-arrow {
    top: 19px;
    right: 18px;
  }
}


/* ---------------------------------------------------------
   SMALL MOBILE
--------------------------------------------------------- */

@media (max-width: 480px) {

  .header-link span {
    display: none;
  }

  .board-card {
    grid-template-columns: 34px 1fr;
    min-height: 160px;
  }

  .board-icon {
    display: none;
  }
}


/* ---------------------------------------------------------
   ACCESSIBILITY
--------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}


/* =========================================================
   BOARDROOM FINAL GLASS + VERTICAL POSITIONING
   ========================================================= */

/* Spread the four boards through the available height */
.boards {
  align-self: stretch;
  display: grid;
  grid-template-rows: repeat(4, 1fr);
  gap: clamp(14px, 1.8vh, 24px);

  height: min(76vh, 800px);
  max-width: 800px;

  justify-self: end;
  align-content: center;
}


/* Genuine smoked glass — room remains clearly visible */
.board-card {
  min-height: 0;
  height: 100%;

  background:
    linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.055) 0%,
      rgba(255, 255, 255, 0.018) 34%,
      rgba(0, 0, 0, 0.055) 100%
    ),
    rgba(8, 7, 6, 0.28);

  border: 1px solid rgba(225, 192, 151, 0.32);

  -webkit-backdrop-filter: blur(5px) brightness(0.82);
  backdrop-filter: blur(5px) brightness(0.82);

  box-shadow:
    0 16px 38px rgba(0, 0, 0, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.075);
}


/* Remove the heavy black appearance from the fake rear sheets */
.glass-layer {
  background: rgba(14, 11, 8, 0.07);
  border-color: rgba(225, 192, 151, 0.13);

  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.glass-layer--one {
  opacity: 0.55;
  transform: translate(6px, 5px);
}

.glass-layer--two {
  opacity: 0.28;
  transform: translate(11px, 9px);
}


/* Very subtle light catching the glass */
.board-card::before {
  background:
    linear-gradient(
      118deg,
      rgba(255, 244, 224, 0.055) 0%,
      rgba(255, 255, 255, 0.015) 22%,
      transparent 48%,
      rgba(216, 138, 45, 0.018) 100%
    );
}


/* Keep hover elegant rather than turning the card black */
.board-card:hover,
.board-card:focus-visible {
  transform: translateX(-7px);

  border-color: rgba(216, 138, 45, 0.58);

  background:
    linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.022) 34%,
      rgba(0, 0, 0, 0.06) 100%
    ),
    rgba(10, 8, 6, 0.34);

  box-shadow:
    10px 22px 48px rgba(0, 0, 0, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.09);
}


/* Desktop: position the entire stack slightly higher */
@media (min-width: 1251px) {
  .boards {
    transform: translateY(-1vh);
  }
}


/* Don't force desktop-height cards on smaller screens */
@media (max-width: 1250px) {
  .boards {
    height: auto;
    grid-template-rows: none;
  }

  .board-card {
    min-height: 158px;
    height: auto;
  }
}

